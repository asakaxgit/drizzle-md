{
  "name": "sqlmd",
  "version": "0.1.0",
  "description": "Query folders of markdown files with SQL: one folder per table, one file per row, frontmatter as columns. Optional Drizzle ORM adapters for SQLite and Postgres (PGlite).",
  "license": "Apache-2.0",
  "author": "Atsushi Sakashita <ats@saks.industries>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakaxgit/drizzle-md.git"
  },
  "homepage": "https://github.com/asakaxgit/drizzle-md#readme",
  "bugs": {
    "url": "https://github.com/asakaxgit/drizzle-md/issues"
  },
  "keywords": [
    "markdown",
    "frontmatter",
    "sql",
    "sqlite",
    "query",
    "content",
    "database",
    "drizzle",
    "drizzle-orm",
    "postgres",
    "pglite"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle.d.ts",
        "default": "./dist/drizzle.js"
      },
      "require": {
        "types": "./dist/drizzle.d.cts",
        "default": "./dist/drizzle.cjs"
      }
    },
    "./pg": {
      "import": {
        "types": "./dist/pg.d.ts",
        "default": "./dist/pg.js"
      },
      "require": {
        "types": "./dist/pg.d.cts",
        "default": "./dist/pg.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-prepopulatedfs": "^0.5.17",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-orm": "^0.45.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-prepopulatedfs": "^0.5.17",
    "drizzle-orm": "^0.45.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-prepopulatedfs": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  }
}
