{
  "name": "drizzle-md",
  "version": "0.0.0",
  "description": "Drizzle ORM adapter that queries folders of markdown files as SQLite tables.",
  "license": "Apache-2.0",
  "author": "Atsushi Sakashita <ats@saks.industries>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakaxgit/drizzle-md.git"
  },
  "homepage": "https://github.com/asakaxgit/drizzle-md#readme",
  "bugs": {
    "url": "https://github.com/asakaxgit/drizzle-md/issues"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "markdown",
    "frontmatter",
    "sqlite",
    "content"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-orm": "^0.45.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0"
  }
}
